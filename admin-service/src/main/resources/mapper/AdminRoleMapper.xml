<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yao.admin.mapper.AdminRoleMapper">

    <resultMap id="currentAdminRoleResultMap" type="com.yao.admin.dao.entity.AdminRoleDO">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="selectEnabledRolesByAdminId" resultMap="currentAdminRoleResultMap">
        SELECT DISTINCT r.id, r.code, r.name
        FROM admin_role r
        INNER JOIN admin_user_role ur ON ur.role_id = r.id
        INNER JOIN admin_user u ON u.id = ur.admin_id
        WHERE ur.admin_id = #{adminId}
          AND u.enabled = 1
          AND r.enabled = 1
        ORDER BY r.code
    </select>

</mapper>
